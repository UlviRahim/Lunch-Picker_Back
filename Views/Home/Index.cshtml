@{
    ViewData["Title"] = "LPicker";
}

<main class="container">
    <h1 class="title">LPicker</h1>
    <div class="wheel-wrapper">
        <div class="wheel-pointer"></div>
        <canvas id="wheel" width="500" height="500"></canvas>
        <button class="spin-btn" id="spin">Fırlat</button>
    </div>

    <div id="selectedMeal" class="selected-meal-card" style="display: none;">
        <div class="selection-info">
            <span class="badge-mini">Sənin Seçimin</span>
            <h2 id="selectedName"></h2>
            <button class="recipe-btn-modern" onclick="searchMealByName()">
                <span>🍳</span> Reseptə Bax
            </button>
        </div>
    </div>

    <div class="controls">
        <button class="outline-btn" id="modifyBtn">Dəyiş</button>
        <button class="circle-btn" id="soundBtn"><i class="fas fa-volume-up"></i></button>
        <button class="circle-btn" id="shareBtn"><i class="fas fa-link"></i></button>
        <button class="outline-btn" id="resultsBtn">Nəticələr</button>
        <button class="circle-btn" id="fullscreenBtn"><i class="fas fa-expand"></i></button>
    </div>

    <div class="suggestion-section">
        <button class="suggest-btn" onclick="getRandomMeal()">
            🎲 Random Yemək Tövsiyə Et
        </button>
    </div>
</main>

<div id="mealModal" class="modal">
    <div class="modal-content">
        <span class="close-trigger" onclick="closeModal()">&times;</span>
        <div id="mealContent" class="meal-content-area">
            <div class="loading">
                <div class="spinner"></div>
                <p>Yemək axtarılır...</p>
            </div>
        </div>
    </div>
</div>

<style>
    /* 1. NƏTİCƏ ÇIXAN HİSSƏ */
    .selected-meal-card {
        text-align: center;
        margin: 25px auto;
        padding: 25px;
        background: rgba(255, 255, 255, 0.95);
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        max-width: 380px;
        border: 1px solid #f1f5f9;
        animation: resultPop 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .badge-mini {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #94a3b8;
        font-weight: 700;
    }

    #selectedName {
        display: block;
        color: #1e293b;
        font-size: 26px;
        margin: 10px 0 20px 0;
        font-weight: 800;
    }

    /* 2. RESEPTƏ BAX DÜYMƏSİ */
    .recipe-btn-modern {
        padding: 12px 30px;
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        color: white;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        font-weight: 600;
        font-size: 15px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .recipe-btn-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 25px rgba(99, 102, 241, 0.4);
    }

    /* 3. RANDOM YEMƏK TÖVSİYƏ ET BUTTON */
    .suggestion-section {
        text-align: center;
        margin-top: 25px;
    }

    .suggest-btn {
        padding: 16px 35px;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        color: white;
        border: none;
        border-radius: 50px;
        cursor: pointer;
        font-size: 16px;
        font-weight: 600;
        box-shadow: 0 10px 25px rgba(16, 185, 129, 0.35);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .suggest-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px rgba(16, 185, 129, 0.45);
    }

    /* 4. MODAL */
    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.7);
        backdrop-filter: blur(8px);
        overflow-y: auto;
        padding: 30px 0;
    }

    .modal-content {
        background: white;
        margin: 0 auto;
        border-radius: 28px;
        width: 92%;
        max-width: 680px;
        position: relative;
        overflow: hidden;
        box-shadow: 0 25px 60px rgba(0, 0, 0, 0.3);
        animation: modalSlideIn 0.3s ease;
    }

    @@keyframes modalSlideIn {
        from {
            transform: translateY(-30px);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }

    /* CLOSE BUTTON */
    .close-trigger {
        position: absolute;
        top: 15px;
        right: 15px;
        width: 40px;
        height: 40px;
        background: rgba(0, 0, 0, 0.3);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        cursor: pointer;
        z-index: 100;
        transition: all 0.3s;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .close-trigger:hover {
        background: #ef4444;
        transform: rotate(90deg);
    }

    .meal-content-area {
        overflow: visible;
    }

    .loading {
        text-align: center;
        padding: 60px 20px;
    }

    .spinner {
        width: 50px;
        height: 50px;
        border: 4px solid #e0e0e0;
        border-top: 4px solid #667eea;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 20px;
    }

    @@keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    /* MEAL IMAGE */
    .meal-image-container {
        position: relative;
        width: 100%;
        height: 300px;
        overflow: hidden;
    }

    .meal-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .meal-image-container:hover .meal-image {
        transform: scale(1.05);
    }

    .meal-image-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50%;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, transparent 100%);
        pointer-events: none;
    }

    .meal-image-title {
        position: absolute;
        bottom: 20px;
        left: 25px;
        right: 25px;
        color: white;
        z-index: 5;
    }

    .meal-image-title h2 {
    font-size: 28px;
    font-weight: bold;
    margin: 0 0 8px 0;
    text-shadow: 2px 2px 8px rgba(255,255,255,0.5);
    color: #000000;
}

    .meal-image-badges {
        display: flex;
        gap: 10px;
    }

   .meal-image-badges .badge {
    padding: 6px 14px;
    background: rgba(255,255,255,0.8);
    backdrop-filter: blur(10px);
    color: #000000;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    border: 1px solid rgba(0,0,0,0.2);
}

    .meal-info {
        padding: 25px;
    }

    .section-title {
        font-size: 17px;
        font-weight: 600;
        margin: 20px 0 12px 0;
        color: #374151;
        padding-bottom: 8px;
        border-bottom: 2px solid #e5e7eb;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* INGREDIENTS & INSTRUCTIONS */
    .ingredients-list {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        background: #f8fafc;
        padding: 16px;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .ingredient {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 12px;
        background: white;
        border-radius: 8px;
        font-size: 13px;
        border: 1px solid #e5e7eb;
        transition: all 0.3s;
    }

    .ingredient:hover {
        transform: translateX(3px);
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .ingredient span:first-child {
        color: #10b981;
        font-weight: bold;
    }

    .ingredient span:last-child {
        color: #374151;
    }

    .instructions {
        font-size: 14px;
        line-height: 1.8;
        color: #374151;
        white-space: pre-line;
        padding: 18px;
        background: #f8fafc;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
    }

    .video-container {
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        margin-top: 8px;
    }

    .video-container iframe {
        width: 100%;
        height: 280px;
        border: none;
    }

    .no-video {
        text-align: center;
        padding: 25px;
        background: #f8fafc;
        border-radius: 12px;
        border: 2px dashed #cbd5e1;
        margin-top: 8px;
    }

    .no-video p {
        color: #64748b;
        margin-bottom: 12px;
    }

    .no-video a {
        color: white;
        font-weight: 600;
        text-decoration: none;
        padding: 12px 24px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        border-radius: 10px;
        display: inline-block;
        transition: all 0.3s;
    }

    .no-video a:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
    }

    /* MODAL FOOTER */
    .modal-footer {
        display: flex;
        gap: 12px;
        padding: 20px 25px;

    }

    .modal-btn {
        flex: 1;
        padding: 14px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 600;
        font-size: 15px;
        transition: all 0.3s;
    }

    .btn-secondary {
        background: white;
        color: #374151;
        border: 1px solid #d1d5db;
    }

    .btn-secondary:hover {
        background: #f3f4f6;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(102, 126, 234, 0.4);
    }

    /* ANIMATIONS */
    @@keyframes resultPop {
        from {
            transform: scale(0.8);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<script>
    let selectedMealName = '';

    function setSelectedMeal(name) {
        selectedMealName = name;
        document.getElementById('selectedName').textContent = name;
        document.getElementById('selectedMeal').style.display = 'block';
    }

    async function getRandomMeal() {
        openModal();
        try {
            const response = await fetch('/Home/RandomMeal');
            const meal = await response.json();
            if (meal.error) {
                showError(meal.error);
            } else {
                showMeal(meal);
            }
        } catch (e) {
            showError('Xəta baş verdi');
        }
    }

    async function searchMealByName() {
        if (!selectedMealName) return;
        openModal();
        try {
            const response = await fetch(`/Home/SearchMeal?name=${encodeURIComponent(selectedMealName)}`);
            const meal = await response.json();
            if (meal.error) {
                showError(meal.error + '. Random tövsiyə alın...');
                setTimeout(getRandomMeal, 1500);
            } else {
                showMeal(meal);
            }
        } catch (e) {
            showError('Xəta baş verdi');
        }
    }

    function openModal() {
        document.getElementById('mealModal').style.display = 'block';
        document.body.style.overflow = 'hidden';
        document.getElementById('mealContent').innerHTML = `
            <div class="loading">
                <div class="spinner"></div>
                <p>Yemək axtarılır...</p>
            </div>
        `;
    }

    function closeModal() {
        document.getElementById('mealModal').style.display = 'none';
        document.body.style.overflow = 'auto';
    }

    function showError(message) {
        document.getElementById('mealContent').innerHTML = `
            <div class="loading">
                <div style="font-size: 48px; margin-bottom: 15px;">😕</div>
                <p>${message}</p>
            </div>
        `;
    }

    function showMeal(meal) {
        let ingredientsHtml = '';
        if (meal.ingredients && meal.ingredients.length > 0) {
            ingredientsHtml = meal.ingredients.map(ing => `
                <div class="ingredient">
                    <span>✓</span>
                    <span>${ing}</span>
                </div>
            `).join('');
        }

        let videoHtml = '';
        if (meal.youtube && meal.youtube.length > 5) {
            let videoUrl = meal.youtube;
            if (videoUrl.includes('watch?v=')) {
                videoUrl = videoUrl.replace('watch?v=', 'embed/');
            }
            if (videoUrl.includes('youtu.be/')) {
                videoUrl = videoUrl.replace('youtu.be/', 'www.youtube.com/embed/');
            }
            videoHtml = `
                <div class="section-title">🎬 Video Resept</div>
                <div class="video-container">
                    <iframe src="${videoUrl}" frameborder="0" allowfullscreen></iframe>
                </div>
            `;
        } else {
            videoHtml = `
                <div class="section-title">🎬 Video</div>
                <div class="no-video">
                    <p>Bu yemək üçün video resept yoxdur</p>
                    <a href="https://www.youtube.com/results?search_query=${encodeURIComponent(meal.name + ' recipe')}" target="_blank">
                        🔍 YouTube-da Axtar
                    </a>
                </div>
            `;
        }

        document.getElementById('mealContent').innerHTML = `
            <div class="meal-image-container">
                <img src="${meal.image}" alt="${meal.name}" class="meal-image">
                <div class="meal-image-overlay"></div>
                <div class="meal-image-title">
                    <h2>${meal.name}</h2>
                    <div class="meal-image-badges">
                        ${meal.category ? `<span class="badge">${meal.category}</span>` : ''}
                        ${meal.area ? `<span class="badge">${meal.area}</span>` : ''}
                    </div>
                </div>
            </div>

            <div class="meal-info">
                <div class="section-title">🥗 Tərkiblər</div>
                <div class="ingredients-list">${ingredientsHtml}</div>

                <div class="section-title">👨‍🍳 Hazırlanma</div>
                <div class="instructions">${meal.instructions}</div>

                ${videoHtml}
            </div>

            <div class="modal-footer">
                <button class="modal-btn btn-secondary" onclick="getRandomMeal()">🔄 Başqa</button>
                <button class="modal-btn btn-primary" onclick="closeModal()">Bağla</button>
            </div>
        `;
    }

    window.onclick = function(event) {
        const modal = document.getElementById('mealModal');
        if (event.target == modal) {
            closeModal();
        }
    }

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
    });
</script>