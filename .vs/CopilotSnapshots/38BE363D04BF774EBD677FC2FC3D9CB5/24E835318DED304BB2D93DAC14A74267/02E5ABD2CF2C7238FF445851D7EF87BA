// 10. EVENT LISTENERS

document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") modal && modal.classList.remove("active");
    if (e.key === "Enter" && modal && modal.classList.contains("active") && confirmBtn)
        confirmBtn.click();
    if (e.code === "Space" && !spinning && !(modal && modal.classList.contains("active"))) {
        e.preventDefault();
        spinWheel();
    }
});

