@model LPicker.Models.WheelItem
@{
    ViewData["Title"] = "Yeni Element";
}

<div class="card-box">
    <h4 class="mb-3">Create form</h4>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label class="form-label">Yemək Adı</label>
            <input class="form-control" asp-for="Name" placeholder="Məsələn: Pizza">
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
        <a class="btn btn-light" asp-action="Index">Cancel</a>
    </form>
</div>