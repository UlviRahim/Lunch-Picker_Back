@model IEnumerable<LPicker.Models.WheelItem>
@{
    ViewData["Title"] = "Çərx Elementləri"; int count = 1;
}

<div class="card-box">
    <h4 class="mb-3">Çərx Elementləri</h4>
    <a class="btn btn-primary mb-3" asp-action="Create">Create</a>
    <div class="table-responsive">
        <table class="table table-dark">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ad</th>
                    <th>Settings</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@count</td>
                        <td>@item.Name</td>
                        <td>
                            <a class="btn btn-warning btn-sm" asp-action="Update" asp-route-id="@item.Id">Update</a>
                            <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                        </td>
                    </tr>
                    count++;
                }
            </tbody>
        </table>
    </div>
</div>