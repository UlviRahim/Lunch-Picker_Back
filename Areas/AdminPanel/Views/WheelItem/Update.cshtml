@model LPicker.Models.WheelItem
@{
    ViewData["Title"] = "Düzəlt";
}

<div class="card-box">
    <h4 class="mb-3">Update form</h4>
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label class="form-label">Yemək Adı</label>
            <input class="form-control" asp-for="Name">
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
        <a class="btn btn-light" asp-action="Index">Cancel</a>
    </form>
</div>