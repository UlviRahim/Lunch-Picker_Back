@model IEnumerable<LPicker.Models.SpinResult>
@{
    ViewData["Title"] = "Nəticələr"; int count = 1;
}

<div class="card-box">
    <h4 class="mb-3">Fırlatma Nəticələri</h4>
    <div class="table-responsive">
        <table class="table table-dark">
            <thead>
                <tr>
                    <th>#</th>
                    <th>İstifadəçi</th>
                    <th>Seçilən</th>
                    <th>Tarix</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@count</td>
                        <td>@(item.User?.UserName ?? "Qonaq")</td>
                        <td>@item.WheelItem?.Name</td>
                        <td>@item.SpinDate.ToString("dd.MM.yyyy HH:mm")</td>
                    </tr>
                    count++;
                }
            </tbody>
        </table>
    </div>
</div>