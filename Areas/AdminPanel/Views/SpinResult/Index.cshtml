@model IEnumerable<LPicker.Models.SpinResult>

@{
    int count = 1;
}

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Spin History</h4>

                <form method="post" asp-action="ClearAll" class="mb-3">
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Clear all history?')">Clear All</button>
                </form>

                <div class="table-responsive pt-3">
                    <table class="table table-dark">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Item Name</th>
                                <th>Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@count</td>
                                    <td><span class="badge badge-primary">@item.ItemName</span></td>
                                    <td>@item.SpinTime.ToString("dd.MM.yyyy HH:mm")</td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>