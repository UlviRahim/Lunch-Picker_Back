@using LPicker.Models
@model List<AppUser>
@{
    ViewData["Title"] = "İstifadəçilər";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="card-box">
    <h4 class="mb-3">👥 İstifadəçilər</h4>
    <div class="table-responsive">
        <table class="table table-dark">
            <thead>
                <tr>
                    <th>#</th>
                    <th>İstifadəçi adı</th>
                    <th>Email</th>
                    <th>Cari Rol</th>
                    <th>Rolu Dəyiş</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var roles = userRoles != null && userRoles.ContainsKey(user.Id)
                    ? userRoles[user.Id]
                    : new List<string>();
                    var currentRole = roles.FirstOrDefault() ?? "Rol yoxdur";

                    <tr>
                        <td>@user.Id.Substring(0, 8)...</td>
                        <td>@user.UserName</td>
                        <td>@user.Email</td>
                        <td>
                            <span class="badge @(currentRole == "SuperAdmin" ? "bg-danger" : currentRole == "Admin" ? "bg-warning" : "bg-info")">
                                @currentRole
                            </span>
                        </td>
                        <td>
                            <form method="post" asp-action="ChangeRole" style="display:inline;">
                                <input type="hidden" name="userId" value="@user.Id" />
                                <select name="newRole" onchange="this.form.submit()" class="form-select form-select-sm" style="width: auto;">
                                    <option value="Member" selected="@(currentRole == "Member")">Member</option>
                                    <option value="Admin" selected="@(currentRole == "Admin")">Admin</option>
                                    <option value="SuperAdmin" selected="@(currentRole == "SuperAdmin")">SuperAdmin</option>
                                </select>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>