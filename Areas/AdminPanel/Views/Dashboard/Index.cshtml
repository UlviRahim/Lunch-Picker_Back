@using LPicker.Models
@{
    ViewData["Title"] = "Dashboard";
    var recentSpins = ViewBag.RecentSpins as List<SpinResult>;
    var topFoods = ViewBag.TopFoods as dynamic;
}

<div class="container-fluid py-4">
    <h2 class="mb-4">📊 Admin Dashboard</h2>

    <!-- Statistika Kartları -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white">
                <div class="card-body text-center">
                    <h3>@ViewBag.TotalSpins</h3>
                    <p class="mb-0">Ümumi Fırlatma</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white">
                <div class="card-body text-center">
                    <h3>@ViewBag.TotalUsers</h3>
                    <p class="mb-0">İstifadəçilər</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white">
                <div class="card-body text-center">
                    <h3>@ViewBag.TotalItems</h3>
                    <p class="mb-0">Yemek Növləri</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark">
                <div class="card-body text-center">
                    <h3>@ViewBag.TodaySpins</h3>
                    <p class="mb-0">Bugünkü Fırlatma</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Son Fırlatmalar -->
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">🕐 Son Fırlatmalar</h5>
                </div>
                <div class="card-body">
                    @if (recentSpins != null && recentSpins.Any())
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>İstifadəçi</th>
                                    <th>Seçilən</th>
                                    <th>Tarix</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var spin in recentSpins)
                                {
                                    <tr>
                                        <td>@spin.Id</td>
                                        <td>@(spin.User?.UserName ?? "Qonaq")</td>
                                        <td>@(spin.Result ?? "Unknown")</td>
                                        <td>@spin.SpinDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center">Hələ fırlatma yoxdur</p>
                    }
                </div>
            </div>
        </div>

        <!-- Ən Çox Seçilənlər -->
        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">🏆 Ən Çox Seçilənlər</h5>
                </div>
                <div class="card-body">
                    @if (topFoods != null && topFoods.Count > 0)
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var food in topFoods)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @food.Name
                                    <span class="badge bg-primary rounded-pill">@food.Count</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted text-center">Məlumat yoxdur</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>